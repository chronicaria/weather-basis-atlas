{% extends "base.html.j2" %}
{% block title %}Weather Basis Atlas{% endblock %}
{% block main %}
<section class="atlas-shell">
  <div class="map-head"><p class="eyebrow">Point-in-time hedge effectiveness</p><h1>Where does a weather index actually travel?</h1><p>County-level basis risk against listed U.S. weather stations.</p></div>
  <div class="controls"><label>Find county <input id="county-search" autocomplete="off" placeholder="County or FIPS"></label><label>Index and month <select id="pair"><optgroup label="Heating degree days"><option value="HDD-01">HDD · January</option><option value="HDD-02">HDD · February</option><option value="HDD-03">HDD · March</option><option value="HDD-04">HDD · April</option><option value="HDD-10">HDD · October</option><option value="HDD-11">HDD · November</option><option value="HDD-12">HDD · December</option></optgroup><optgroup label="Cooling degree days"><option value="CDD-04">CDD · April</option><option value="CDD-05">CDD · May</option><option value="CDD-06">CDD · June</option><option value="CDD-07">CDD · July</option><option value="CDD-08">CDD · August</option><option value="CDD-09">CDD · September</option><option value="CDD-10">CDD · October</option></optgroup></select></label><fieldset><legend>Map layer</legend><button data-layer="he" aria-pressed="true">Hedge effect</button><button data-layer="station">Station</button><button data-layer="fails">Exceptions</button></fieldset></div>
  <div class="map-stage"><canvas id="atlas-map" width="975" height="610" tabindex="0" aria-label="County hedge effectiveness map. Use search to choose a county." role="img"></canvas><div id="station-key" aria-label="Station legend"></div></div>
</section>
<aside id="drawer" aria-live="polite"><p class="eyebrow">County record</p><h2 id="county-name">Loading county…</h2><p id="run-badges" class="badges"></p><div class="metrics"><div><span>Best station</span><strong id="best-station">—</strong></div><div><span>Point-in-time HE</span><strong id="he-pit">—</strong></div><div><span>Nearest station HE</span><strong id="he-nearest">—</strong></div><div><span>Stability</span><strong id="stability">—</strong></div></div><section><h3>Hedge panel</h3><table><thead><tr><th>Station</th><th>HE</th><th>Distance</th></tr></thead><tbody id="hedge-table"></tbody></table></section><section class="explorer"><div><p class="eyebrow">Modelled option indication</p><h3>Strike explorer</h3></div><label>Strike <input id="strike" type="range" min="0" max="100" value="50" step="1"><output id="strike-value">—</output></label><div class="quote-grid"><div><span>Bid</span><strong id="quote-bid">—</strong></div><div><span>Mid</span><strong id="quote-mid">—</strong></div><div><span>Ask</span><strong id="quote-ask">—</strong></div><div><span>Expected payout</span><strong id="quote-payout">—</strong></div></div><p id="quote-note" class="quiet">Choose a county with model draws to inspect the quote grid.</p></section></aside>
<script src="assets/vendor/d3.v7.9.0.min.js"></script><script src="assets/vendor/topojson-client.v3.1.0.min.js"></script><script type="module" src="assets/static/js/atlas.js"></script>
{% endblock %}

    "contract_year": {
      "type": "integer"
    },
    "index": {
      "type": "string"
    },
    "month": {
      "type": "integer"
    },
    "observation_start": {
      "type": "string"
    },
    "observation_end": {
      "type": "string"
    },
    "valuation_date": {
      "type": "string"
    },
    "timing_status": {
      "type": "string"
    },
    "observed_start": {
      "anyOf": [
        {
          "type": "string"
        },
        {

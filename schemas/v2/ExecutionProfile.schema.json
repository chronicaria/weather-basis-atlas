{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ExecutionProfile",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "name": {
      "type": "string"
    },
    "workers": {
      "type": "integer"
    },
    "memory_gib": {
      "type": "number"
    },
    "cache_dir": {
      "type": "string"
    },
    "scratch_dir": {
      "type": "string"
    },
    "chunk_counties": {
      "type": "integer"
    },
    "blas_threads": {
      "type": "integer"
    },
    "telemetry": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version"
  ],
  "additionalProperties": false
}

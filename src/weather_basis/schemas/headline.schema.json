{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["pairs", "bootstrap_B", "seed", "config_hash", "git_commit", "atlas_run_id"],
  "properties": {
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["pair", "no_hedge_share_counties", "no_hedge_share_population", "best_ne_nearest_share", "switch_gain_he_median", "no_stable_proxy_share", "threshold_shares", "zero_distance", "n_stations_effective", "n_counties", "n_test_seasons_min", "n_test_seasons_max"],
        "properties": {
          "pair": {"type": "string"},
          "no_hedge_share_counties": {"type": "number", "minimum": 0, "maximum": 1},
          "no_hedge_share_population": {"type": "number", "minimum": 0, "maximum": 1},
          "best_ne_nearest_share": {"type": "number", "minimum": 0, "maximum": 1},
          "switch_gain_he_median": {"type": ["number", "null"]},
          "no_stable_proxy_share": {"type": "number", "minimum": 0, "maximum": 1},
          "threshold_shares": {"type": "object"},
          "zero_distance": {"type": "array"},
          "n_stations_effective": {"type": "integer", "minimum": 0},
          "n_counties": {"type": "integer", "minimum": 1},
          "n_test_seasons_min": {"type": "integer", "minimum": 0},
          "n_test_seasons_max": {"type": "integer", "minimum": 0}
        }
      }
    },
    "bootstrap_B": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "config_hash": {"type": "string"},
    "git_commit": {"type": "string"},
    "atlas_run_id": {"type": "string"}
  }
}
